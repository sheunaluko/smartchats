{
  "name": "smartchats-relay-connect",
  "version": "0.1.0",
  "description": "Shared helper for outbound bridge WebSocket connections to smartchats-relay (auth + reconnect + reauth). Consumed by bin/pty-bridge.mjs and smartchats-mcp-bridge.",
  "type": "module",
  "main": "index.mjs",
  "types": "index.d.mts",
  "exports": {
    ".": {
      "types": "./index.d.mts",
      "default": "./index.mjs"
    }
  },
  "files": [
    "index.mjs",
    "index.d.mts"
  ],
  "dependencies": {
    "smartchats-cloud-client": "*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.0"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT"
}
