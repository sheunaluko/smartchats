{
  "query": "UPSERT type::record($table_name, $key) SET content = $v0, ts = <datetime> $v1, local_date = $v2, local_tz = $v3",
  "variables": {
    "key": "abc",
    "table_name": "logs",
    "v0": "hi",
    "v1": "2026-03-23T15:04:05.000Z",
