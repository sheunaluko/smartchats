exports[`builder golden snapshots > buildRelateQuery emits stable SurrealQL 1`] = `
{
  "query": "LET $in_rec = type::record($in_table, $in_key); LET $rel_rec = type::record($rel_table, $rel_key); LET $out_rec = type::record($out_table, $out_key); DELETE $rel_rec; RELATE $in_rec -> $rel_rec -> $out_rec SET name = $v0;",
  "variables": {
    "in_key": "leo",
    "in_table": "user_entities",
    "out_key": "guitar",
    "out_table": "user_entities",
    "rel_key": "abc",
    "rel_table": "user_relations",
    "v0": "owns",
  },
}
`;

