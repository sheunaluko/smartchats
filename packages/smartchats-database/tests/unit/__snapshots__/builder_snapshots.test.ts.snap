  },
}
`;

exports[`builder golden snapshots > buildKnowledgeInsertQuery emits stable SurrealQL 1`] = `
{
  "query": "CREATE user_entities CONTENT { name: "Leo", embedding: [0.1,0.2,0.3], ts: d'2026-03-23T15:04:05.000Z', local_date: "2026-03-23", local_tz: "America/Chicago" };
RELATE (SELECT VALUE id FROM user_entities WHERE name = "Leo" LIMIT 1)->user_relations->(SELECT VALUE id FROM user_entities WHERE name = "guitar" LIMIT 1) CONTENT { name: "owns", sourceName: "Leo", targetName: "guitar", kind: "possession", embedding: [0.1,0.2,0.3], ts: d'2026-03-23T15:04:05.000Z', local_date: "2026-03-23", local_tz: "America/Chicago" };",
  "variables": {},
}
`;

exports[`builder golden snapshots > buildMetricsQuery emits stable SurrealQL 1`] = `
{
  "query": "SELECT time::year(<datetime> local_date) AS yr, time::week(<datetime> local_date) AS wk, metric_name, math::mean(value) AS value, unit FROM metrics WHERE metric_name IN ['steps', 'water'] AND local_date >= '2026-03-01' AND local_date <= '2026-03-31' GROUP BY yr, wk, metric_name, unit ORDER BY yr ASC, wk ASC",
  "variables": {},
}
`;

exports[`builder golden snapshots > buildMetricsTimeFilter emits stable SurrealQL 1`] = `"local_date >= '2026-03-01' AND local_date <= '2026-06-01'"`;

